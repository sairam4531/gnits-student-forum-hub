{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gnits-student-affairs",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gnits-student-affairs-db"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "gnits-student-affairs"
    }
  ]
}